{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "**/dist",
    "coverage",
    "**/coverage",
    "supabase/.temp",
    "supabase/.branches"
  ],
  "plugins": ["react", "oxc", "import", "typescript"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": [
      "error",
      {
        "ignoreExternal": true,
        "ignoreTypes": false
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(?:@/|(?:\\.\\.?/)+(?:src/)?)features/[^/]+/[^/]",
            "message": "Import from the feature folder to use its public index.ts. Use relative sibling imports inside a feature."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/web/src/{features,lib,server}/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:@/|(?:\\.\\.?/)+(?:src/)?)features/[^/]+/[^/]",
                "message": "Import from the feature folder to use its public index.ts. Use relative sibling imports inside a feature."
              },
              {
                "regex": "^(?:@/|(?:\\.\\.?/)+(?:src/)?)(?:app|routes)(?:/|$)",
                "message": "Keep app and route wiring in the composition layer. Pass dependencies into the feature through its public API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:@/|(?:\\.\\.?/)+(?:src/)?)(?:app|features|routes)(?:/|$)",
                "message": "Shared modules must be independent of app wiring, routes, and business features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.{jsx,tsx}"],
      "plugins": ["react", "oxc", "import", "typescript", "jsx-a11y"],
      "rules": {
        "jsx-a11y/alt-text": "warn"
      }
    },
    {
      "files": ["packages/contracts/src/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@eight-burgers/(?:web|api)",
                "message": "Shared contracts must not depend on web or api workspaces."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@eight-burgers/web",
                "message": "API workspace must not import from web workspace."
              }
            ]
          }
        ]
      }
    }
  ]
}
