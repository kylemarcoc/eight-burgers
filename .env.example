# ==============================================================================
# Frontend (apps/web) — Public build-time variables (bundled into browser JS)
# ==============================================================================
# Relative API base URL proxied by Vite dev server (http://localhost:5173/api/v1 -> http://127.0.0.1:8787/api/v1)
VITE_API_BASE_URL=/api/v1

# Show "Staff Portal" in the top navigation by default for local demos/testing.
# Set to "true" in hosting environments to hide the nav link (server-side /admin login is always enforced).
VITE_HIDE_PUBLIC_ADMIN=false

# ==============================================================================
# Backend REST BFF (apps/api) — Server-only variables (NEVER prefix with VITE_)
# Copy into gitignored apps/api/.env.local after running `npm run db:status`.
# ==============================================================================
PORT=8787
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourshop.ph

# Dedicated HMAC secret for signing guest order receipt tokens.
# REQUIRED (minimum 32 characters) when NODE_ENV=production; uses a deterministic dev fallback otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_SIGNING_SECRET=replace-with-random-32-plus-char-secret-in-production

# Set to "true" ONLY when running behind a trusted reverse proxy that strips and sets X-Forwarded-For / X-Real-IP.
TRUST_PROXY=false

# Set to "true" ONLY in local/staging demos to enable POST /api/v1/admin/menu-items/reset and /delivery-pricing/reset.
ENABLE_DEMO_RESET=false

# Local Supabase CLI stack defaults (populated by `npm run db:start` / `npm run db:status`)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key-from-npm-run-db-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-npm-run-db-status
