# ==============================================================================
# Frontend (apps/web) — Public build-time variables (bundled into browser JS)
# ==============================================================================
# Relative API base URL proxied by Vite dev server (http://localhost:5173/api/v1 -> http://127.0.0.1:8787/api/v1)
VITE_API_BASE_URL=/api/v1

# Show "Owner Admin" in the top navigation by default for local demos/testing.
# Set to "true" in hosting environments to hide the nav link (server-side /admin login is always enforced).
VITE_HIDE_PUBLIC_ADMIN=false

# ==============================================================================
# Backend REST BFF (apps/api) — Server-only variables (NEVER prefix with VITE_)
# Copy into gitignored apps/api/.env.local after running `npm run db:status`.
# ==============================================================================
PORT=8787
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# COOKIE_DOMAIN=.8burgers.ph

# Local Supabase CLI stack defaults (populated by `npm run db:start` / `npm run db:status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key-from-npm-run-db-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-npm-run-db-status
