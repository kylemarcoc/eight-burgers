{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__vercel_path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__vercel_path=/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/index?__vercel_path=/healthz"
    },
    {
      "source": "/readyz",
      "destination": "/api/index?__vercel_path=/readyz"
    },
    {
      "source": "/((?!api/|api$|healthz$|readyz$).*)",
      "destination": "/index.html"
    }
  ]
}
