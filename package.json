{
  "name": "eight-burgers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@eight-burgers/web",
    "dev:api": "npm run dev --workspace=@eight-burgers/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "preview": "npm run preview --workspace=@eight-burgers/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.6.2",
    "supabase": "^2.76.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
